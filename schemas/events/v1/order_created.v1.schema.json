{
  "$id": "https://example.com/schemas/events/v1/order_created.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCreatedV1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "event_type": {
      "const": "OrderCreated"
    },
    "producer": {
      "const": "order-service"
    },
    "key": {
      "type": "object",
      "required": [
        "order_id"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "customer_id",
        "currency",
        "total_amount",
        "items"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "total_amount": {
          "type": "number",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "product_id",
              "qty",
              "unit_price",
              "line_total"
            ],
            "properties": {
              "product_id": {
                "type": "string"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price": {
                "type": "number",
                "minimum": 0
              },
              "line_total": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
