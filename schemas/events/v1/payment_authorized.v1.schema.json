{
  "$id": "https://example.com/schemas/events/v1/payment_authorized.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentAuthorizedV1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "event_type": {
      "const": "PaymentAuthorized"
    },
    "producer": {
      "const": "payment-service"
    },
    "key": {
      "type": "object",
      "required": [
        "order_id"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": [
        "payment_id",
        "order_id",
        "amount",
        "currency",
        "status"
      ],
      "properties": {
        "payment_id": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "status": {
          "const": "AUTHORIZED"
        },
        "provider_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
